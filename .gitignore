# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# The suite is kept out of the published repository. It stays on disk and must
# still pass before anything is tagged; CI skips the test steps when the
# directory is absent rather than failing.
tests/

# Runtime state — never commit a validator's scores, EMA or round records
state/
*.sqlite
*.sqlite-journal
*.db

# Artifacts pulled during evaluation. These are GB-scale and belong in the
# registry cache, never in the repo.
artifacts/
cache/
work/
*.sqlite-wal
*.sqlite-shm

# Corpora. The fixed partition is the anchor of the published series and the
# rotating pool must stay out of public reach — a corpus in git is a corpus a
# miner can train against.
corpus/
*.jsonl
!microtensor/tasks/reference_fingerprints/*.jsonl

# Secrets and local config
.env
.env.*
!.env.example

# Wallets — never, under any circumstance
wallets/
*.json.key
