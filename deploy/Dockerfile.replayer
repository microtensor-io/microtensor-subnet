FROM python:3.12-slim AS pins

COPY microtensor_subnet/artifact/contract.py /contract.py
RUN python -c "import importlib.util; s=importlib.util.spec_from_file_location('c','/contract.py'); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); open('/requirements.txt','w').write(''.join(f'{k}=={v}\n' for k,v in m.ALLOWED_PACKAGES.items()))"

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    OPENBLAS_CORETYPE=Nehalem \
    OMP_NUM_THREADS=1 \
    MKL_ENABLE_INSTRUCTIONS=SSE4_2 \
    MKL_CBWR=COMPATIBLE \
    FAKETIME="@2026-01-01 00:00:00 x0" \
    LD_PRELOAD=/usr/lib/x86_64-linux-gnu/faketime/libfaketime.so.1

RUN apt-get update \
 && apt-get install -y --no-install-recommends libfaketime \
 && rm -rf /var/lib/apt/lists/*

COPY --from=pins /requirements.txt /requirements.txt
RUN pip install --no-deps -r /requirements.txt \
 && pip uninstall -y pip setuptools wheel \
 && rm -rf /root/.cache /requirements.txt

WORKDIR /artifact
USER 65534:65534

CMD ["python", "-X", "utf8", "/artifact/main.py"]
