FROM python:3.12-slim AS pins

COPY microtensor/artifact/contract.py /contract.py
RUN python -c "import importlib.util; s=importlib.util.spec_from_file_location('c','/contract.py'); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); open('/requirements.txt','w').write(''.join(f'{k}=={v}\n' for k,v in m.ALLOWED_PACKAGES.items()))"

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp

COPY --from=pins /requirements.txt /requirements.txt
RUN pip install --no-deps -r /requirements.txt \
 && pip uninstall -y pip setuptools wheel \
 && rm -rf /root/.cache /requirements.txt

WORKDIR /artifact
USER 65534:65534

CMD ["python", "/artifact/main.py"]
