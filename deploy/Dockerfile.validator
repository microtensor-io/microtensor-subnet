FROM python:3.14-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    MT_HOME=/var/lib/microtensor

RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/microtensor

COPY pyproject.toml README.md ./
COPY microtensor ./microtensor
COPY neurons ./neurons
COPY deploy ./deploy

RUN pip install --upgrade pip \
 && pip install -e ".[validator,gguf,huggingface,s3]"

RUN useradd --system --create-home --uid 10001 validator \
 && mkdir -p ${MT_HOME}/state ${MT_HOME}/cache ${MT_HOME}/work ${MT_HOME}/corpus \
 && chown -R validator:validator ${MT_HOME} \
 && chmod +x /opt/microtensor/deploy/validator-entrypoint.sh

USER validator
VOLUME ["/var/lib/microtensor"]

HEALTHCHECK --interval=5m --timeout=30s --start-period=10m --retries=3 \
    CMD mt inspect engines || exit 1

ENTRYPOINT ["/opt/microtensor/deploy/validator-entrypoint.sh"]
